{{!
Declares a domain for the administration folder of every site.
}}# This file is{{! not }} autogenerated.
definitions:
  config:
    /hippo:configuration/hippo:domains/administrationfolders:
      jcr:primaryType: hipposys:domain
      /editor:
        jcr:primaryType: hipposys:authrole
        hipposys:groups: [cmsadmin]
        hipposys:role: editor
      /administration:
        jcr:primaryType: hipposys:domainrule
        /include-administration-folder:
          jcr:primaryType: hipposys:facetrule
          hipposys:equals: true
          hipposys:facet: jcr:path
          hipposys:filter: false
          hipposys:type: Reference
          hipposys:value: /content/documents/administration
      /urlrewriter:
        jcr:primaryType: hipposys:domainrule
        /include-administration-folder:
          jcr:primaryType: hipposys:facetrule
          hipposys:equals: true
          hipposys:facet: jcr:path
          hipposys:filter: false
          hipposys:type: Reference
          hipposys:value: /content/urlrewriter
{{#sites}}
      /{{id}}:
        jcr:primaryType: hipposys:domainrule
        /include-{{id}}-administration-folder:
          jcr:primaryType: hipposys:facetrule
          hipposys:equals: true
          hipposys:facet: jcr:path
          hipposys:filter: false
          hipposys:type: Reference
          hipposys:value: /content/documents/{{id}}/administration
{{/sites}}
